# Firebase web config — paste yours from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration)
# These NEXT_PUBLIC_ values are safe to expose in client code.
# Copy this file to .env.local and fill in the values, then rebuild.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public Cloudflare Worker endpoint used for private media upload/download.
# Leave empty to keep the app on Firestore/local media only.
NEXT_PUBLIC_R2_WORKER_URL=

# ---------------------------------------------------------------------------
# مفتاح مساحة المزامنة **لا مكان له هنا ولا في أيّ ملفّ بيئة.**
# كان في الكود فرعٌ يقرأ `NEXT_PUBLIC_SYNC_SPACE` وقد أُزيل: أيّ متغيّرٍ يبدأ
# بـ`NEXT_PUBLIC_` يُحقَن حرفياً في حِزَم JS المنشورة، فوضعُ المفتاح فيه نشرٌ
# للسرّ لا إخفاءٌ له. يُكتب مرّةً واحدة لكلّ جهاز من بطاقة «مفتاح المزامنة»
# في الإعدادات، ويعيش في `localStorage` وحده.
# ---------------------------------------------------------------------------
