{
  "name": "my-dream-app",
  "version": "0.1.453",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-version.mjs && next build && node scripts/gen-precache.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-madar-rules-test --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "doctor:ai": "node scripts/ai-doctor.mjs",
    "css:dead": "node scripts/dead-css.mjs",
    "bump": "node scripts/bump-version.mjs",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build && npm --prefix cloudflare-worker run typecheck"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.7",
    "@capgo/capacitor-updater": "^8.51.23",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^12.15.0",
    "heic2any": "0.0.4",
    "idb-keyval": "^6.2.6",
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capgo/cli": "^8.64.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.20",
    "firebase-tools": "^15.26.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
